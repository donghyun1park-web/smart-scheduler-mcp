# Smart Scheduler — 환경변수 설정 파일
# 복사 후 .env로 저장: cp .env.example .env

# ── Vision AI 프로바이더 ──────────────────────────────────────────────────────
# 선택: gemini (기본, 무료 티어) 또는 claude
VISION_PROVIDER=gemini

# [권장] Gemini API 키 — 무료 발급
# https://aistudio.google.com → "Get API key"
# 무료 티어: 일 1,500장, 분당 15장 — 현장팀 충분
GEMINI_API_KEY=AIzaSy...

# 사용할 Gemini 모델 (기본값: gemini-2.0-flash)
# 옵션: gemini-2.0-flash / gemini-1.5-flash / gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# [선택] Claude API 키 — VISION_PROVIDER=claude 일 때만 필요
# https://console.anthropic.com 에서 발급 (유료)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 기본 DB 경로 ──────────────────────────────────────────────────────────────
# NAS 볼륨 마운트 경로와 일치해야 함
DEFAULT_DB_PATH=/data/현장.scheduler
